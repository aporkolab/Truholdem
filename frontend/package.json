{
  "name": "texas-holdem-frontend",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npx serve -s dist/texas-holdem-frontend",
    "dev": "ng serve --proxy-config proxy.conf.js",
    "build": "ng build --configuration=production",
    "build:prod": "ng build --configuration=production",
    "watch": "ng build --watch --configuration=development",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:coverage": "jest --coverage",
    "test:dev-proxy": "node scripts/verify-dev-proxy.cjs",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "cypress open",
    "e2e:headless": "cypress run",
    "e2e:ci": "cypress run --browser chrome --headless",
    "e2e:a11y-regression": "node scripts/verify-a11y-failure.cjs",
    "start:e2e": "node scripts/start-e2e-server.js",
    "test:all": "npm run test:ci && npm run e2e:ci"
  },
  "private": true,
  "homepage": "https://www.truholdem.aporkolab.com",
  "dependencies": {
    "@angular/animations": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@ngrx/component-store": "22.0.1",
    "@ngrx/operators": "22.0.1",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/jasmine": "~7.0.0",
    "@types/jest": "^30.0.0",
    "angular-eslint": "22.6.0",
    "axe-core": "^4.14.0",
    "cypress": "^16.2.1",
    "cypress-real-events": "^1.15.1",
    "eslint": "^10.14.0",
    "jasmine-core": "~7.0.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-jasmine2": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "puppeteer": "^25.16.0",
    "rollup": "^4.67.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
